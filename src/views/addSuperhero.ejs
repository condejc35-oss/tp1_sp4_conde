<%- include('partials/header', { title: 'Agregar Superhéroe' }) %>

<style>
    h1 { color: #FF6500; margin-bottom: 24px; font-size: 1.8rem; }
    .form-container {
        max-width: 600px;
        margin: 0 auto;
        background: #16213e;
        padding: 36px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }
    .form-group { margin-bottom: 18px; }
    label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    input {
        width: 100%;
        padding: 10px 14px;
        background: #0f3460;
        border: 1px solid #1a4a8a;
        border-radius: 6px;
        color: #eee;
        font-size: 14px;
        transition: border 0.2s;
    }
    input:focus { outline: none; border-color: #e94560; }
    input::placeholder { color: #555; }
    button[type="submit"] {
        width: 100%;
        padding: 12px;
        background: #e94560;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 8px;
    }
    button[type="submit"]:hover { background: #c73652; }
    .error {
        background: rgba(231,76,60,0.15);
        border: 1px solid #e74c3c;
        color: #e74c3c;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 14px;
    }
    .error ul { padding-left: 20px; margin-top: 6px; }
    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #aaa;
        text-decoration: none;
        font-size: 14px;
    }
    .back-link:hover { color: #e94560; }
</style>

<div class="form-container">

    <h1>Agregar Superhéroe</h1>

    <% if (errors && errors.length > 0) { %>
        <div class="error">
            <strong>Corregí los siguientes errores:</strong>
            <ul>
                <% errors.forEach(function(error) { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <form action="/api/heroes/agregar" method="POST">
        <div class="form-group">
            <label>Nombre del Superhéroe *</label>
            <input type="text" name="nombreSuperHeroe" minlength="3" maxlength="60" required
                   placeholder="Ej: Spider-Man"
                   value="<%= nombreSuperHeroe ? nombreSuperHeroe : '' %>"/>
        </div>
        <div class="form-group">
            <label>Nombre Real *</label>
            <input type="text" name="nombreReal" minlength="3" maxlength="60" required
                   placeholder="Ej: Peter Parker"
                   value="<%= nombreReal ? nombreReal : '' %>"/>
        </div>
        <div class="form-group">
            <label>Edad *</label>
            <input type="number" name="edad" min="0" required
                   placeholder="Ej: 25"
                   value="<%= edad ? edad : '' %>"/>
        </div>
        <div class="form-group">
            <label>Planeta de Origen *</label>
            <input type="text" name="planetaOrigen"
                   placeholder="Ej: Tierra"
                   value="<%= planetaOrigen ? planetaOrigen : '' %>"/>
        </div>
        <div class="form-group">
            <label>Poderes *(separados por coma)</label>
            <input type="text" name="poderes" required
                   placeholder="Ej: Volar, Super fuerza"
                   value="<%= poderes ? poderes : '' %>"/>
        </div>
        <div class="form-group">
            <label>Aliados *(separados por coma)</label>
            <input type="text" name="aliados"
                   placeholder="Ej: Robin, Alfred"
                   value="<%= aliados ? aliados : '' %>"/>
        </div>
        <div class="form-group">
            <label>Enemigos *(separados por coma)</label>
            <input type="text" name="enemigos"
                   placeholder="Ej: Joker, Bane"
                   value="<%= enemigos ? enemigos : '' %>"/>
        </div>
        <div class="form-group">
            <label>Creador *</label>
            <input type="text" name="creador"
                   placeholder="Ej: Stan Lee"
                   value="<%= creador ? creador : '' %>"/>
        </div>
        <button type="submit">Agregar Superhéroe</button>
    </form>

    <a href="/api/heroes" class="back-link">← Volver al Dashboard</a>

</div>

<%- include('partials/footer') %>