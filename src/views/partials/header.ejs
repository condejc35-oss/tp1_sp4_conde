<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Arial', sans-serif;
            background-color: #080616;
            color: #eee;
            min-height: 100vh;
            padding: 40px 20px;
        }
        nav {
            max-width: 1100px;
            margin: 0 auto 30px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #16213e;
            padding: 14px 24px;
            border-radius: 10px;
            border: solid #1A1953 2px;
        }
        nav:hover{
            border: solid blue 2px;
        }
        nav .logo {
            font-size: 1.3rem;
            font-weight: bold;
            color: white;
            text-decoration: none;
        }
        nav .nav-links { display: flex; gap: 16px; }
        nav .nav-links a {
            color: #aaa;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.2s;
        }
        nav .nav-links a:hover { color: #e94560; }
        .container { max-width: 1100px; margin: 0 auto; }
    </style>
</head>
<body>

    <nav>
        <a href="/api/heroes" class="logo">App Superhéroes</a>
        <div class="nav-links">
            <a href="/api/heroes">Dashboard</a>
            <a href="/api/heroes/agregar">+ Agregar Héroe</a>
        </div>
    </nav>

    <div class="container">