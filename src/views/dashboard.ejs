<div class="header-actions">
    <h1 style="color:#e94560;">Dashboard de Superhéroes</h1>
    <a href="/api/heroes/agregar" class="btn-primary">+ Agregar Héroe</a>
</div>

<div class="stats">
    Total de superhéroes: <span><%= heroes.length %></span>
</div>

<% if (heroes.length === 0) { %>
    <div class="empty">No hay superhéroes registrados todavía.</div>
<% } else { %>
    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Nombre Real</th>
                <th>Edad</th>
                <th>Planeta</th>
                <th>Poderes</th>
                <th>Creador</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% heroes.forEach(function(hero) { %>
            <tr>
                <td><strong><%= hero.nombreSuperHeroe %></strong></td>
                <td><%= hero.nombreReal %></td>
                <td><%= hero.edad %></td>
                <td><%= hero.planetaOrigen || 'Desconocido' %></td>
                <td>
                    <% hero.poderes.forEach(function(poder) { %>
                        <span class="badge"><%= poder %></span>
                    <% }) %>
                </td>
                <td><%= hero.creador || '-' %></td>
                <td>
                    <div class="acciones">
                        <a href="/api/heroes/<%= hero._id %>/editar" class="btn-warning">Editar</a>

                        <form action="/api/heroes/<%= hero._id %>?_method=DELETE"
                            method="POST"
                            onsubmit="return confirm('¿Eliminar a <%= hero.nombreSuperHeroe %>?')">
                            <button type="submit" class="btn-danger">Eliminar</button>
                        </form>
                    </div>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>